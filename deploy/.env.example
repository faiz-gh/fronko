# Database (managed externally)
DATABASE_URL=postgres://fronko_admin:password@your-db-host:5432/fronko_db?sslmode=disable

# Secrets: at least 16 characters, e.g. `openssl rand -base64 32`
JWT_SECRET=replace-with-a-long-random-string

# The session cookie is marked Secure (HTTPS-only) by default. Only set this to
# false when serving over plain http, e.g. local testing.
# COOKIE_SECURE=false

# Encrypts users' S3 keys at rest (32 bytes, base64): `openssl rand -base64 32`.
# Optional: without it, photo and brochure uploads are disabled.
# Keep it stable and backed up; changing it makes saved storage keys unreadable.
SECRETS_KEY=
