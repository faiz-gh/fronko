# Database (managed externally)
DATABASE_URL=postgres://fronko_admin:password@your-db-host:5432/fronko_db?sslmode=disable

# Secrets: at least 16 characters, e.g. `openssl rand -base64 32`
JWT_SECRET=replace-with-a-long-random-string

# The session cookie is marked Secure (HTTPS-only) by default. Only set this to
# false when serving over plain http, e.g. local testing.
# COOKIE_SECURE=false

# Encrypts S3 keys and integration secrets (API keys, OAuth tokens, SAML keys) at
# rest (32 bytes, base64): `openssl rand -base64 32`.
# Optional: without it, photo and brochure uploads are disabled, and so are
# integrations that store a secret (HubSpot, SAML, signed webhooks).
# Keep it stable and backed up; changing it makes saved keys and secrets unreadable.
SECRETS_KEY=

# Outgoing email for verification and password-reset codes, via any SMTP
# provider. Port 465 uses implicit TLS; other ports upgrade with STARTTLS.
# Without SMTP_HOST, codes are only written to the backend log.
# Examples: Resend smtp.resend.com:587 (user "resend", password = API key),
#           Amazon SES email-smtp.<region>.amazonaws.com:587, Brevo smtp-relay.brevo.com:587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be an address your provider lets you send from.
SMTP_FROM="Fronko <no-reply@your-domain.com>"

# Public URLs, so the app isn't tied to fixed hosts or ports.
# FRONTEND_URL: where the site is served, e.g. https://fronko.app. Set it even when the
# API is on the same domain: integrations build sign-in, OAuth and card links from it.
# It's also allowed as a CORS origin; comma-separate several
# (e.g. https://fronko.app,https://www.fronko.app); the first is the site's address.
# BACKEND_URL: public API URL the browser calls. Leave empty to route API calls
# through the frontend's nginx (same-origin, no CORS). If set on another domain,
# use a subdomain of the same site (e.g. api.fronko.app) so the session cookie is sent.
# OAuth callbacks, SAML and SCIM addresses are then on it.
FRONTEND_URL=
BACKEND_URL=

# where new product feedback is emailed, and the Reply-To on admin replies.
FEEDBACK_NOTIFY_EMAIL=

# Optional: days of card analytics events (views, clicks, saves) to keep. Default 395 (about 13 months).
ANALYTICS_RETENTION_DAYS=395

# Optional: where people reach the site, if it isn't the first FRONTEND_URL.
# Integrations that need an address (HubSpot, SAML, SCIM) are unavailable until
# one of the two is set.
# PUBLIC_URL=

# Optional: background jobs (such as syncing leads to a CRM) each backend runs at
# once. Default 2; 0 queues jobs without running them on this instance.
JOB_WORKERS=2

# FRONKO_ENV is fixed to "production" in docker-compose.yml. "development" (used by
# docker-compose.local.yml) lets integrations call private addresses and enables
# `fronko seed`; never use it for a real deployment.
